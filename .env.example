SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=project-backend
DB_USER=postgres
DB_PASSWORD=postgres
# update conserva los datos entre reinicios (no usar create-drop en produccion)
DDL_AUTO=update
SHOW_SQL=false

JWT_SECRET=
# Access token: 900000 ms (15 min). Refresh token: 604800000 ms (7 dias).
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

CORS_ALLOWED_ORIGINS=http://localhost:3000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ASISTENTE_LIMITE_DIARIO=30

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
