# Copia este archivo como ".env" en la raiz del proyecto y completa los valores.
# El .env NO se sube a GitHub (esta en el .gitignore). Este .env.example si.

# Servidor y base de datos (los usan Spring y docker-compose)
SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_gamarra
DB_USER=postgres
DB_PASSWORD=postgres

# JWT: en produccion usar una clave propia en Base64 (minimo 32 bytes)
# JWT_SECRET=

# IA (Gemini). Key gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
